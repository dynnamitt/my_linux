{
  "manifest_version": 3,
  "name": "img-src-reframer",
  "version": "0.1.0",
  "description": "Reframe table/list thumbnail galleries into a clean square grid; hover a cell to preview the full-size linked image.",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "action": {
    "default_title": "img-src-reframer",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    }
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "optional_host_permissions": ["<all_urls>"],
  "background": {
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "img-src-reframer@kdm.local",
      "strict_min_version": "127.0"
    }
  }
}
